{
  "name": "nihongo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @nihongo/web",
    "dev:admin": "npm run dev --workspace @nihongo/admin",
    "dev:server": "npm run dev --workspace @nihongo/api",
    "dev:api": "npm run dev:server",
    "setup:env": "node tools/setup-env.mjs",
    "build": "npm run build:web && npm run build:admin && npm run build:server",
    "build:web": "npm run build --workspace @nihongo/web",
    "build:admin": "npm run build --workspace @nihongo/admin",
    "build:server": "npm run build --workspace @nihongo/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test": "npm run check:boundaries && npm run test:frontend && npm run test:server",
    "test:frontend": "node --experimental-strip-types --test apps/web/tests/*.test.mjs apps/admin/tests/*.test.mjs packages/shared/tests/*.test.mjs",
    "test:server": "npm run test --workspace @nihongo/api",
    "test:review": "node --experimental-strip-types --test apps/web/tests/review.test.mjs",
    "test:routes": "node --experimental-strip-types --test apps/web/tests/routes.test.mjs",
    "test:import": "node --experimental-strip-types --test apps/web/tests/vocab-import.test.mjs",
    "test:vocab-progress": "node --experimental-strip-types --test apps/web/tests/vocab-progress.test.mjs",
    "test:vocab-study": "node --test packages/shared/tests/vocab-study.test.mjs",
    "test:roadmap": "node --test packages/shared/tests/roadmap.test.mjs",
    "test:roadmap-study": "node --test packages/shared/tests/roadmap-study.test.mjs",
    "test:default-roadmap": "node --test packages/shared/tests/default-roadmap.test.mjs",
    "test:settings": "node --experimental-strip-types --test apps/web/tests/learning-settings.test.mjs apps/web/tests/speech.test.mjs",
    "test:kana": "node --test packages/shared/tests/kana-quiz.test.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "npm run db:migrate --workspace @nihongo/api",
    "db:generate": "npm run db:generate --workspace @nihongo/api",
    "preview": "npm run preview --workspace @nihongo/web",
    "preview:admin": "npm run preview --workspace @nihongo/admin"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
