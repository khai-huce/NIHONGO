{
  "name": "nhai-kanji-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "setup:env": "node server/scripts/setup-env.mjs",
    "build:server": "npm --prefix server run build",
    "test:server": "npm --prefix server test",
    "test:review": "node --experimental-strip-types --test tests/review.test.mjs",
    "test:routes": "node --experimental-strip-types --test tests/routes.test.mjs",
    "test:import": "node --experimental-strip-types --test tests/vocab-import.test.mjs",
    "test:vocab-progress": "node --experimental-strip-types --test tests/vocab-progress.test.mjs",
    "test:vocab-study": "node --test tests/vocab-study.test.mjs",
    "test:roadmap": "node --test tests/roadmap.test.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "npm --prefix server run db:migrate",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
