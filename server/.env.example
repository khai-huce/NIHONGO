NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://nihongo:nihongo_local_only@localhost:5433/nihongo?schema=public
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Same Web client ID as VITE_GOOGLE_CLIENT_ID. Blank keeps email login available.
GOOGLE_CLIENT_ID=
