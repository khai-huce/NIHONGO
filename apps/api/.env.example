NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
DATABASE_URL=postgresql://nihongo:nihongo_local_only@localhost:5433/nihongo?schema=public
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Same Web client ID as VITE_GOOGLE_CLIENT_ID. Blank keeps email login available.
GOOGLE_CLIENT_ID=
# Optional: apps/api/.venv-tts is detected automatically, then python on PATH.
# TTS_PYTHON=C:/path/to/python.exe
# Optional private media storage; default apps/api/storage/reading (never served as a public directory).
# TTS_STORAGE_DIR=C:/path/to/private-reading-audio
# C03 grammar grading, A03 sentence analysis and Shadowing share Gemini. Use a project WITHOUT billing.
# Never put this key in VITE_* or client code. Blank disables AI, model checking still works.
GEMINI_API_KEY=
# Choose an available free-tier model in your AI Studio project; no paid fallback.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional model for A05b reading questions only; other AI features keep GEMINI_MODEL.
# Omit to use the shared model; no automatic fallback or separate quota.
# READING_QUIZ_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional model for Shadowing video only. Omit to use GEMINI_MODEL; no automatic fallback.
# Choose a free-tier video model available to your project before enabling.
# SHADOWING_GEMINI_MODEL=gemini-3.5-flash-lite
# Shared application caps across grading + sentence analysis + Shadowing in a rolling 24h (provider limits may be lower).
GEMINI_DAILY_LIMIT=20
GEMINI_GLOBAL_DAILY_LIMIT=100
# Enable YouTube Data API v3 and restrict this server-only key to that API.
# Metadata verifies that video is public, embeddable, not live and shorter than 30 minutes.
# Shadowing additionally permits at most 3 AI video requests/account and 10 globally per rolling 24h.
YOUTUBE_API_KEY=
