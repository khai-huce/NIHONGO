generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(100)
  passwordHash String?  @map("password_hash")
  googleSub    String?  @unique @map("google_sub") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url")
  isPremium    Boolean  @default(false) @map("is_premium")
  role         String   @default("user") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  kanjiProgress KanjiProgress[]
  reviewCards ReviewCard[]
  vocabLessons VocabLesson[]
  vocabProgress VocabProgress[]
  vocabStudyResults VocabStudyResult[]
  personalRoadmaps PersonalRoadmap[]
  defaultRoadmapProgress DefaultRoadmapProgress[]
  kanaQuizResults KanaQuizResult[]
  readingArticles ReadingArticle[]
  curriculumProgress CurriculumProgress[]
  curriculumStudyResults CurriculumStudyResult[]
  curriculumReviewSets CurriculumReviewSet[]
  curriculumReviewResults CurriculumReviewResult[]
  grammarProgress GrammarProgress[]
  grammarAttempts GrammarAttempt[]
  grammarAiRequests GrammarAiRequest[]
  sentenceAnalysisRequests SentenceAnalysisRequest[]
  xpEvents XpEvent[]
  shadowingVideos ShadowingVideo[]
  shadowingStudies ShadowingStudy[]
  shadowingGrades ShadowingGrade[]
  shadowingAttempts ShadowingAttempt[]
  shadowingAiRequests ShadowingAiRequest[]
  jlptEnrollments JlptEnrollment[]
  jlptProgress JlptSessionProgress[]
  jlptAttempts JlptAttempt[]

  @@map("users")
}

// Reward claims survive edits/deletion of learning content; only account deletion removes them.
model XpEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  kind String @db.VarChar(16)
  sourceKey String @map("source_key") @db.VarChar(300)
  dedupeKey String @map("dedupe_key") @db.VarChar(64)
  studyDate DateTime @map("study_date") @db.Date
  points Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, studyDate])
  @@index([studyDate, userId])
  @@map("xp_events")
}

model KanjiProgress {
  userId     String   @map("user_id") @db.Uuid
  kanjiId    String   @map("kanji_id") @db.VarChar(32)
  memorized  Boolean
  reviewedAt DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kanjiId])
  @@map("kanji_progress")
}

// Read/written by connect-pg-simple; Prisma only manages the migration.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "sessions_expire_idx")
  @@map("sessions")
}

model ReviewCard {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  category String @db.VarChar(16)
  sourceId String @map("source_id") @db.VarChar(300)
  front String @db.VarChar(500)
  back String @db.VarChar(2000)
  reading String @default("") @db.VarChar(500)
  hint String @default("") @db.VarChar(2000)
  active Boolean @default(true)
  dueAt DateTime @default(now()) @map("due_at") @db.Timestamptz(3)
  intervalSeconds Int @default(0) @map("interval_seconds")
  reviewCount Int @default(0) @map("review_count")
  version Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ReviewEvent[]
  @@unique([userId, category, sourceId])
  @@index([userId, active, dueAt])
  @@map("review_cards")
}

model ReviewEvent {
  id String @id @default(uuid()) @db.Uuid
  cardId String @map("card_id") @db.Uuid
  rating String @db.VarChar(8)
  reviewedAt DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  dueAt DateTime @map("due_at") @db.Timestamptz(3)
  elapsedMs Int @map("elapsed_ms")
  card ReviewCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@index([cardId, reviewedAt])
  @@map("review_events")
}

model ReadingArticle {
  jlptResources JlptResource[]
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  scope String @default("personal") @db.VarChar(16)
  version Int @default(0)
  content Json
  sourceId String? @map("source_id") @db.VarChar(64)
  publishedSourceId String? @map("published_source_id") @db.VarChar(64)
  publishedContent Json? @map("published_content")
  publishedVersion Int? @map("published_version")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  source ContentSource? @relation("ReadingDraftSource", fields: [sourceId], references: [id], onDelete: Restrict)
  publishedSource ContentSource? @relation("ReadingPublishedSource", fields: [publishedSourceId], references: [id], onDelete: Restrict)
  audio ReadingAudio[]
  @@index([userId, scope, createdAt])
  @@map("reading_articles")
}

model ReadingAudio {
  id String @id @db.Uuid
  articleId String @map("article_id") @db.Uuid
  articleVersion Int @map("article_version")
  contentHash String @map("content_hash") @db.VarChar(64)
  voice String @db.VarChar(64)
  provider String @default("edge-tts") @db.VarChar(32)
  status String @db.VarChar(16)
  claimToken String @map("claim_token") @db.Uuid
  leaseUntil DateTime @map("lease_until") @db.Timestamptz(3)
  segments Json @default("[]")
  durationSec Float @default(0) @map("duration_sec")
  characterCount Int @map("character_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  article ReadingArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@unique([articleId, articleVersion, voice])
  @@index([articleId, contentHash, voice, status])
  @@index([createdAt, status])
  @@map("reading_audio")
}

model VocabLesson {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  name String @db.VarChar(100)
  words Json @default("[]")
  version Int @default(0)
  progressVersion Int @default(0) @map("progress_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress VocabProgress[]
  @@index([userId, createdAt])
  @@map("vocab_lessons")
}

model VocabProgress {
  userId String @map("user_id") @db.Uuid
  wordId String @map("word_id") @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  memorized Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson VocabLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([lessonId])
  @@map("vocab_progress")
}

// Completed rounds retain their lesson snapshot even when the source lesson is deleted.
model VocabStudyResult {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  lessonName String @map("lesson_name") @db.VarChar(100)
  lessonVersion Int @map("lesson_version")
  kind String @db.VarChar(8)
  mode String @db.VarChar(8)
  total Int
  correct Int
  answers Json
  submissionHash String @map("submission_hash") @db.VarChar(64)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId, kind, completedAt])
  @@map("vocab_study_results")
}

model PersonalRoadmap {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  name String @db.VarChar(100)
  rawKanji String @map("raw_kanji") @db.VarChar(2000)
  kanjiList String[] @map("kanji_list")
  perDay Int @map("per_day")
  version Int @default(0)
  assessments Json @default("{}")
  completedDays Int[] @default([]) @map("completed_days")
  progressVersion Int @default(0) @map("progress_version")
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("personal_roadmaps")
}

model DefaultRoadmapProgress {
  userId String @map("user_id") @db.Uuid
  catalogId String @map("catalog_id") @db.VarChar(32)
  assessments Json @default("{}")
  completedDays Int[] @default([]) @map("completed_days")
  progressVersion Int @default(0) @map("progress_version")
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  activityDays String[] @default([]) @map("activity_days")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, catalogId])
  @@map("default_roadmap_progress")
}

model KanaQuizResult {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  catalogId String @map("catalog_id") @db.VarChar(32)
  mode String @db.VarChar(16)
  total Int
  correct Int
  answers Json
  submissionHash String @map("submission_hash") @db.VarChar(64)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("kana_quiz_results")
}

model ContentSource {
  jlptDraftRoadmaps JlptRoadmap[] @relation("JlptDraftSource")
  jlptPublishedRoadmaps JlptRoadmap[] @relation("JlptPublishedSource")
  id String @id @db.VarChar(64)
  name String @db.VarChar(200)
  url String
  license String @db.VarChar(200)
  licenseUrl String @map("license_url")
  version String @db.VarChar(100)
  checksum String @db.VarChar(64)
  attribution String @db.VarChar(1000)
  notes String @db.VarChar(2000)
  kanji KanjiContent[] @relation("KanjiPublishedSource")
  kanjiDrafts KanjiContent[] @relation("KanjiDraftSource")
  radicals RadicalContent[] @relation("RadicalPublishedSource")
  radicalDrafts RadicalContent[] @relation("RadicalDraftSource")
  readings ReadingArticle[] @relation("ReadingDraftSource")
  publishedReadings ReadingArticle[] @relation("ReadingPublishedSource")
  curriculumDrafts CurriculumCourse[] @relation("CurriculumDraftSource")
  curricula CurriculumCourse[] @relation("CurriculumPublishedSource")
  grammarDrafts GrammarCourse[] @relation("GrammarDraftSource")
  grammarCourses GrammarCourse[] @relation("GrammarPublishedSource")
  pitchEntries PitchAccentEntry[]
  shadowingDrafts ShadowingVideo[] @relation("ShadowingDraftSource")
  shadowingVideos ShadowingVideo[] @relation("ShadowingPublishedSource")
  @@map("content_sources")
}

// Dictionary assertions are kept with their source; no inferred accents or generated audio.
model PitchAccentEntry {
  id String @id @db.VarChar(64)
  word String @db.VarChar(100)
  reading String @db.VarChar(100)
  wordKey String @map("word_key") @db.VarChar(100)
  readingKey String @map("reading_key") @db.VarChar(100)
  romaji String @db.VarChar(200)
  variants Json
  conjugations Json @default("[]")
  sourceId String @map("source_id") @db.VarChar(64)
  sourceLine Int @map("source_line")
  sourceNotation String @map("source_notation") @db.VarChar(500)
  published Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  source ContentSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, word, reading])
  @@index([published, wordKey])
  @@index([published, readingKey])
  @@index([published, romaji])
  @@map("pitch_accent_entries")
}

model KanjiContent {
  jlptResources JlptResource[]
  id String @id @db.VarChar(32)
  character String @unique @db.VarChar(8)
  level String @db.VarChar(2)
  hanViet String @map("han_viet") @db.VarChar(500)
  meaning String @db.VarChar(2000)
  dictionaryRadicalNumber Int? @map("dictionary_radical_number")
  sourceId String @map("source_id") @db.VarChar(64)
  draftSourceId String @map("draft_source_id") @db.VarChar(64)
  source ContentSource @relation("KanjiPublishedSource", fields: [sourceId], references: [id], onDelete: Restrict)
  draftSource ContentSource @relation("KanjiDraftSource", fields: [draftSourceId], references: [id], onDelete: Restrict)
  published Json?
  draft Json
  status String @default("draft") @db.VarChar(16)
  version Int @default(0)
  sortOrder Int @default(100000) @map("sort_order")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([status, level, sortOrder])
  @@map("kanji_content")
}

model RadicalContent {
  number Int @id
  sourceId String @map("source_id") @db.VarChar(64)
  draftSourceId String @map("draft_source_id") @db.VarChar(64)
  source ContentSource @relation("RadicalPublishedSource", fields: [sourceId], references: [id], onDelete: Restrict)
  draftSource ContentSource @relation("RadicalDraftSource", fields: [draftSourceId], references: [id], onDelete: Restrict)
  published Json?
  draft Json
  status String @default("draft") @db.VarChar(16)
  version Int @default(0)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("radical_content")
}

// Published roadmap versions are inserted once; existing progress keeps its original day partition.
model CatalogDefinition {
  id String @id @db.VarChar(32)
  level String @db.VarChar(2)
  perDay Int @map("per_day")
  kanjiIds String[] @map("kanji_ids")
  kanjiList String[] @map("kanji_list")
  @@map("catalog_definitions")
}

// The draft tree is an atomic editorial document. Published rows keep their IDs after removal.
model CurriculumCourse {
  id String @id @db.Uuid
  slug String @unique @db.VarChar(80)
  version Int @default(0)
  draft Json
  sourceId String? @map("source_id") @db.VarChar(64)
  publishedSourceId String? @map("published_source_id") @db.VarChar(64)
  publishedVersion Int? @map("published_version")
  title String @default("") @db.VarChar(100)
  subtitle String @default("") @db.VarChar(200)
  description String @default("") @db.VarChar(2000)
  level String @default("N5") @db.VarChar(2)
  style String @default("custom") @db.VarChar(16)
  topicCount Int @default(0) @map("topic_count")
  lessonCount Int @default(0) @map("lesson_count")
  wordCount Int @default(0) @map("word_count")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  source ContentSource? @relation("CurriculumDraftSource", fields: [sourceId], references: [id], onDelete: Restrict)
  publishedSource ContentSource? @relation("CurriculumPublishedSource", fields: [publishedSourceId], references: [id], onDelete: Restrict)
  topics CurriculumTopic[]
  lessons CurriculumLesson[]
  reviewSets CurriculumReviewSet[]
  @@index([archivedAt, publishedVersion])
  @@map("curriculum_courses")
}

model CurriculumTopic {
  id String @id @db.Uuid
  courseId String @map("course_id") @db.Uuid
  title String @default("") @db.VarChar(100)
  japanese String @default("") @db.VarChar(200)
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(false)
  course CurriculumCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lessons CurriculumLesson[]
  @@index([courseId, active, sortOrder])
  @@map("curriculum_topics")
}

model CurriculumLesson {
  jlptResources JlptResource[]
  id String @id @db.Uuid
  courseId String @map("course_id") @db.Uuid
  topicId String @map("topic_id") @db.Uuid
  title String @default("") @db.VarChar(100)
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(false)
  version Int @default(0)
  words Json @default("[]")
  wordCount Int @default(0) @map("word_count")
  // A compact identity ledger prevents moving or reusing a removed word UUID in another lesson.
  retainedWordIds String[] @default([]) @map("retained_word_ids") @db.Uuid
  course CurriculumCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  topic CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  progress CurriculumProgress[]
  studyResults CurriculumStudyResult[]
  @@index([courseId, active])
  @@index([topicId, active, sortOrder])
  @@index([retainedWordIds], type: Gin)
  @@map("curriculum_lessons")
}

model CurriculumProgress {
  userId String @map("user_id") @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  progress Json @default("{}")
  version Int @default(0)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CurriculumLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("curriculum_progress")
}

model CurriculumStudyResult {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  lessonName String @map("lesson_name") @db.VarChar(200)
  lessonVersion Int @map("lesson_version")
  kind String @db.VarChar(8)
  mode String @db.VarChar(8)
  total Int
  correct Int
  answers Json
  submissionHash String @map("submission_hash") @db.VarChar(64)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CurriculumLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  @@index([userId, lessonId, kind, completedAt])
  @@index([lessonId])
  @@map("curriculum_study_results")
}

// One review set per account and exact normalized selection, independent from source-lesson progress.
model CurriculumReviewSet {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  lessonIds String[] @map("lesson_ids") @db.Uuid
  selectionHash String @map("selection_hash") @db.VarChar(64)
  progress Json @default("{}")
  progressVersion Int @default(0) @map("progress_version")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  course CurriculumCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  results CurriculumReviewResult[]
  @@unique([userId, courseId, selectionHash], map: "curriculum_review_sets_selection_key")
  @@index([courseId])
  @@map("curriculum_review_sets")
}

model CurriculumReviewResult {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  reviewSetId String @map("review_set_id") @db.Uuid
  lessonName String @map("lesson_name") @db.VarChar(200)
  lessonVersion Int @map("lesson_version")
  kind String @db.VarChar(8)
  mode String @db.VarChar(8)
  total Int
  correct Int
  answers Json
  submissionHash String @map("submission_hash") @db.VarChar(64)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewSet CurriculumReviewSet @relation(fields: [reviewSetId], references: [id], onDelete: Cascade)
  @@index([userId, reviewSetId, kind, completedAt], map: "curriculum_review_results_latest_idx")
  @@index([reviewSetId])
  @@map("curriculum_review_results")
}

// Drafts are saved atomically; published rows retain identity after removal or archive.
model GrammarCourse {
  id String @id @db.Uuid
  slug String @unique @db.VarChar(80)
  version Int @default(0)
  draft Json
  sourceId String? @map("source_id") @db.VarChar(64)
  publishedSourceId String? @map("published_source_id") @db.VarChar(64)
  publishedVersion Int? @map("published_version")
  title String @default("") @db.VarChar(100)
  subtitle String @default("") @db.VarChar(200)
  description String @default("") @db.VarChar(2000)
  level String @default("N5") @db.VarChar(2)
  lessonCount Int @default(0) @map("lesson_count")
  patternCount Int @default(0) @map("pattern_count")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  source ContentSource? @relation("GrammarDraftSource", fields: [sourceId], references: [id], onDelete: Restrict)
  publishedSource ContentSource? @relation("GrammarPublishedSource", fields: [publishedSourceId], references: [id], onDelete: Restrict)
  lessons GrammarLesson[]
  @@index([archivedAt, publishedVersion])
  @@map("grammar_courses")
}

model GrammarLesson {
  id String @id @db.Uuid
  courseId String @map("course_id") @db.Uuid
  title String @default("") @db.VarChar(100)
  japanese String @default("") @db.VarChar(200)
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(false)
  course GrammarCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  patterns GrammarPattern[]
  @@index([courseId, active, sortOrder])
  @@map("grammar_lessons")
}

model GrammarPattern {
  jlptResources JlptResource[]
  id String @id @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  content Json @default("{}")
  version Int @default(0)
  active Boolean @default(false)
  sortOrder Int @default(0) @map("sort_order")
  retainedExerciseIds String[] @default([]) @map("retained_exercise_ids") @db.Uuid
  retainedExampleIds String[] @default([]) @map("retained_example_ids") @db.Uuid
  lesson GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  progress GrammarProgress[]
  attempts GrammarAttempt[]
  aiRequests GrammarAiRequest[]
  @@index([lessonId, active, sortOrder])
  @@index([retainedExerciseIds], type: Gin)
  @@index([retainedExampleIds], type: Gin)
  @@map("grammar_patterns")
}

model GrammarProgress {
  userId String @map("user_id") @db.Uuid
  patternId String @map("pattern_id") @db.Uuid
  version Int @default(0)
