{
  "name": "@nihongo/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "content:seed": "tsx scripts/content-seed.ts",
    "content:import": "tsx scripts/content-import.ts",
    "pitch:import": "tsx scripts/pitch-import.ts",
    "admin:role": "tsx scripts/content-admin.ts",
    "test": "tsc -p tsconfig.test.json && node --env-file=.env.test scripts/prepare-test-db.mjs && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nihongo/shared": "*",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "connect-pg-simple": "10.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "google-auth-library": "11.0.2",
    "helmet": "8.3.0",
    "kuromoji": "^0.1.2",
    "pg": "8.23.0",
    "wanakana": "5.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
